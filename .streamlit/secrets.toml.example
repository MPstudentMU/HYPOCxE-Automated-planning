# Shared-passphrase gate for the whole app (see engine/auth.py and the
# README's "Access control" section). Only the SHA-256 hash of the
# passphrase is stored here — never the plaintext passphrase itself.
#
# Generate a hash for your chosen passphrase:
#
#   python -c "import hashlib; print(hashlib.sha256(b'yourpassphrase').hexdigest())"
#
# Copy this file to .streamlit/secrets.toml (gitignored — see .gitignore)
# and replace the placeholder below with your real hash. To rotate the
# passphrase later, generate a new hash the same way and replace it again.

app_passphrase_hash = "REPLACE_WITH_SHA256_HEX_DIGEST"
